#include "main.h"
#include <stdio.h>

/**
 * print_array - prints n elements of an array of integers
 * @a : pointers
 * @n : init
 * Return: Always 0.
 */

void print_array(int *a, int n)
{
	int i;

	for (i = 0; i < n; i++) /* boucle tout les elements du tableau */
	{
		if (i > 0)
		{
			printf(", ");
		}
		else
		{
			printf("%d", a[i]);
		}
	}
	printf("\n");
}
